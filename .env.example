# .env.example — Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env réel ne doit JAMAIS être commité (cf. .gitignore).

# =============================================================================
# SOURCE VIDÉO
# =============================================================================

# true = webcam locale (index 0), false = caméra IP MJPEG
USE_LOCAL_CAM=true

# URL du flux MJPEG si USE_LOCAL_CAM=false
REMOTE_SOURCE=http://192.168.1.1:5000/video

# =============================================================================
# RECONNAISSANCE FACIALE
# =============================================================================

# Similarité cosinus minimale pour valider une identification (0.0–1.0).
# Plus HAUT = plus strict (le code teste `score >= seuil`).
# Repères mesurés avec antelopev2/glintr100 : 0.40 (permissif) – 0.50 (strict).
# Au-delà de 0.60, même la bonne personne est rejetée.
RECOGNITION_THRESHOLD=0.45

# =============================================================================
# SERVEUR FLASK
# =============================================================================

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
