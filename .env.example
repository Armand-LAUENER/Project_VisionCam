# .env.example — Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env réel ne doit JAMAIS être commité (cf. .gitignore).

# =============================================================================
# SOURCE VIDÉO
# =============================================================================

# true = webcam locale (index 0), false = caméra IP MJPEG
USE_LOCAL_CAM=true

# URL du flux MJPEG si USE_LOCAL_CAM=false
REMOTE_SOURCE=http://192.168.1.1:5000/video

# Identifiant de la caméra dans le journal d'événements (table events).
# CAMERA_ID=cam0

# Plusieurs caméras : id=source;id=source — numéro de webcam, URL (http, rtsp)
# ou chemin de vidéo / séquence MOT17. Vide : une seule caméra (CAMERA_ID).
# CAMERAS=hall=~/datasets/visioncam/scene-01;porte=rtsp://192.168.1.20/flux
# Traitement des caméras : thread (défaut) ou process, avec CAMERAS_PER_WORKER
# caméras par processus. Au-delà de 2 caméras, process tient la cadence.
# CAMERA_WORKERS=process
# CAMERAS_PER_WORKER=2

# Simulation de caméra : une vidéo, un motif d'images ou un dossier de séquence
# MOT17 (tools/record_sequence.py) à la place de la caméra.
#   realtime    : cadence d'origine, images sautées si le pipeline est trop lent
#   every_frame : chaque image traitée dans l'ordre (déterministe)
# VIDEO_FILE=~/datasets/visioncam/scene-01
# VIDEO_MODE=every_frame
# VIDEO_LOOP=false
# Pistes affichées, une ligne par piste et par image (image,id,x,y,l,h,nom).
# TRACKS_LOG_PATH=data/tracks.csv

# Test d'endurance : une ligne par minute (mémoire, VRAM, FPS, structures
# internes). Avec VIDEO_LOOP=true, puis : uv run -m tools.endurance_report <fichier>
# ENDURANCE_LOG_PATH=data/endurance.csv
# ENDURANCE_INTERVAL_S=60

# =============================================================================
# RECONNAISSANCE FACIALE
# =============================================================================

# Similarité cosinus minimale pour valider une identification (0.0–1.0).
# Plus HAUT = plus strict (le code teste `score >= seuil`).
# Mesuré sur CHIRLA dans les conditions de l'application (tools/bench_face.py
# --thresholds, visages ≥ 40 px) : à 0,45, 80 % de bons noms et 3,0 % de
# mauvais (IC 95 % : 1,9-4,6 %) ; à 0,50, 65 % et 1,2 % (0,6-2,4 %). Au-delà
# de 0,55, la bonne personne est presque toujours rejetée.
RECOGNITION_THRESHOLD=0.45

# Taille minimale d'un visage (px) pour lui attribuer un nom. En dessous, les
# embeddings confondent davantage les personnes (cf. config.py).
RECOGNITION_MIN_FACE_PX=40

# Visages nets reconnus « Inconnu » d'affilée avant qu'une piste perde son nom
# (échange de pistes avec une personne non enrôlée).
RECOGNITION_UNKNOWN_STREAK=3
# Seuls les visages de face comptent dans cette série (nez au centre des yeux)
FRONTAL_NOSE_MARGIN=0.25

# Une piste visible reconnue sous son nom depuis moins de N images le garde
# quand une autre l'obtient, sauf confiance plus haute de la marge.
IDENTITY_PROTECT_FRAMES=90
IDENTITY_STEAL_MARGIN=0.05

# Source de l'estimation d'orientation (face/profil/dos).
#   mediapipe : inférence Mediapipe sur un crop, CPU, ~26 ms par personne/frame
#   yolo      : relecture des keypoints COCO déjà produits par YOLOv8-Pose sur
#               GPU, ~0.01 ms — 95 % d'accord avec mediapipe en cadrage proche
POSE_SOURCE=yolo

# Implémentation de l'association de tracks.
#   python : deep_sort_realtime (défaut)
#   rust   : crate deepsort-rs, installé par uv sync (groupe rust) — mêmes
#            pistes, mais 15 à 20 % plus lent sur l'étape tracker complète
#            mesurée (passage des tableaux vers le crate). Voir
#            docs/rust-tracker.md.
# bytetrack | botsort | botsort-reid : trackers d'ultralytics, suivent mieux
#            mais nomment moins bien sur CHIRLA (docs/tracking.md).
TRACKER_BACKEND=python

# Modèle YOLO-Pose. Le moteur TensorRT FP16 divise par ~2 le temps de l'étape
# YOLO et supprime ses pics de latence ; il se construit une fois par machine
# (voir docs/performance.md).
# YOLO_MODEL=yolov8s-pose.engine

# Recouvrement au-delà duquel YOLO fusionne deux boîtes (0,7 dans ultralytics).
# 0,6 évite les pistes dédoublées d'une personne assise (cf. docs/tracking.md).
YOLO_NMS_IOU=0.6
# Boîte contenue à 90 % dans une autre plus sûre (IoU ≥ 0,5) : écartée. 0 désactive.
NESTED_BOX_MIN_CONTAINED=0.9

# Embedder d'apparence du tracker. Le moteur TensorRT FP16 réduit l'étape
# tracker de ~19 à ~14 ms (MOT17, RTX 4060) sans dégrader MOTA ni IDF1 ; il se
# construit une fois par machine : uv run -m tools.export_embedder_engine
# DEEPSORT_EMBEDDER_ENGINE=mobilenetv2-embedder.engine

# Reconnaissance faciale en TensorRT FP16 : ~5,7 ms par visage au lieu de ~12,6 ms.
# Moteurs construits au premier lancement (~2 min), gardés dans data/trt_cache/.
# INSIGHTFACE_TENSORRT=true

# =============================================================================
# SERVEUR FLASK
# =============================================================================

FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Accès protégé : sans l'un de ces deux réglages, n'importe qui sur le réseau
# local peut voir le flux, enrôler ou supprimer des personnes.
# Préférer le hash, écrit dans .env (saisie masquée) avec :
#   uv run python tools/set_password.py
# ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...'
# ADMIN_PASSWORD=

# Threads du serveur HTTP (waitress). Chaque onglet ouvert en garde deux en
# permanence (flux vidéo + événements) : prévoir 2 × spectateurs + quelques-uns.
SERVER_THREADS=32

# Historique des présences : durée de conservation en jours (0 = sans limite).
PRESENCE_RETENTION_DAYS=30
# Délai (s) depuis la dernière reconnaissance du visage au-delà duquel une piste
# n'inscrit plus son nom dans l'historique (personne de dos, échange de pistes).
PRESENCE_FACE_MAX_AGE_S=300
